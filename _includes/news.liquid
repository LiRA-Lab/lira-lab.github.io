<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <!-- Timeline: each item gets a joint-shaped marker, like the robot arm in the LiRA logo -->
    <ol class="news-timeline">
      {% for item in news limit: news_limit %}
        <li class="news-item{% if item.category %} news-cat-{{ item.category | slugify }}{% endif %}">
          <div class="news-meta">
            {{ item.date | date: '%b %d, %Y' }}
            {% if item.category %}· <span class="news-category">{{ item.category }}</span>{% endif %}
            {% if item.venue %}<span class="news-venue">{{ item.venue }}</span>{% endif %}
          </div>
          {% if item.inline %}
            <div class="news-headline">{{ item.title }}</div>
            <div class="news-body">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
          {% else %}
            <a class="news-headline" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
